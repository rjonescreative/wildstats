# Cloudflare Account ID
# Found at: Cloudflare Dashboard → right sidebar
CF_ACCOUNT_ID=your_cloudflare_account_id

# R2 API Token credentials
# Created at: Cloudflare Dashboard → R2 → Manage R2 API Tokens → Create API Token
# Permissions needed: Object Read & Write on the wildstats-data bucket
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# R2 bucket name (whatever you named your bucket)
R2_BUCKET_NAME=wildstats-data
